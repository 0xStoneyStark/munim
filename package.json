{
  "name": "munim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "agent": "tsx apps/munim/src/run.ts",
    "dashboard": "tsx apps/munim/src/dashboard.ts",
    "purse": "tsx packages/zcash-purse/src/cli.ts",
    "purse:mcp": "tsx packages/zcash-purse/src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsx apps/munim/src/check.ts",
    "swiggy:login": "tsx apps/munim/src/swiggy-mcp.ts login",
    "swiggy:tools": "tsx apps/munim/src/swiggy-mcp.ts tools",
    "telegram": "tsx apps/munim/src/telegram.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "@noir-wallet/sdk": "^0.1.9",
    "dotenv": "^16.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  }
}
