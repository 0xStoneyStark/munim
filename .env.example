# Bitrefill API key from https://www.bitrefill.com/account/developers (never commit the real one)
BITREFILL_API_KEY=
# Anthropic API key — the agent's brain is claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Phone number (E.164) that top-up rules recharge, e.g. +919876543210
TOPUP_PHONE=
# Absolute path to the zcash-devtool binary built from https://github.com/zcash/zcash-devtool
ZCASH_DEVTOOL=D:/free-society-hack/tools/zcash-devtool/target/release/zcash-devtool.exe
# Wallet directories (created with `zcash-devtool wallet init`)
PURSE_WALLET_DIR=./wallets/agent
PURSE_IDENTITY=./wallets/agent-identity.txt
PURSE_VIEW_WALLET_DIR=./wallets/agent-view
